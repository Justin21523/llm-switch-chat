# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Model Backend Settings (hf, llamacpp, openai)
MODEL_BACKEND=hf
MODEL_ID=Qwen/Qwen2-7B-Instruct

# HuggingFace Settings (for MODEL_BACKEND=hf)
HF_DEVICE=auto
HF_TORCH_DTYPE=auto

# llama.cpp Settings (for MODEL_BACKEND=llamacpp)
GGUF_PATH=./models/qwen2-7b-instruct-q4_k_m.gguf
LLAMACPP_N_CTX=4096
LLAMACPP_N_GPU_LAYERS=-1

# OpenAI-compatible Settings (for MODEL_BACKEND=openai)
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=sk-default

# Generation Settings
MAX_TOKENS=1024
TEMPERATURE=0.7
TOP_P=0.9

# RAG Settings
ENABLE_RAG=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vectorstore
RAG_TOP_K=5